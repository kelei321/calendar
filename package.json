{
  "name": "vivo-style-pwa-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --import tsx --test tests/dateUtils.test.ts tests/calendarSettings.test.ts",
    "typecheck": "tsc -b",
    "build": "vite build",
    "build:pages": "vite build --base=/calendar/",
    "ci": "npm run test && npm run typecheck && npm run build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dayjs": "^1.11.13",
    "idb": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
